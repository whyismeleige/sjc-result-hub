# ── Local development environment ────────────────────────────────────────
# Copy to `.env` and adjust. NEVER commit real credentials.
# In production these become Vercel Environment Variables.

# Prisma runtime connection (local dev = your local PostgreSQL).
# On Supabase use the transaction pooler URL (port 6543) here.
DATABASE_URL="postgresql://leige@localhost:5432/sjc_result_hub_dev"

# Prisma migration/admin connection (direct, no pooler). On Supabase use port 5432.
DIRECT_URL="postgresql://leige@localhost:5432/sjc_result_hub_dev"

# App (public, safe to expose)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SJC Result Hub"

# Admin secret (optional): requests presenting this via the `x-admin-secret`
# header or `admin_secret` query param bypass API rate limits. Set it in
# production; leave unset to disable admin access.
# ADMIN_SECRET="choose-a-long-random-value"

# ── Data migration tooling (scripts/database) ───────────────────────────
# Only needed when running `npm run db:*` data pipelines.
# SOURCE_DATABASE_URL  -> the legacy local "student_results" database (READ ONLY).
# TARGET_DATABASE_URL -> the clean destination (e.g. Supabase) database.
# SOURCE_DATABASE_URL="postgresql://leige@localhost:5432/student_results"
# TARGET_DATABASE_URL="postgresql://leige@localhost:5432/sjc_result_hub_dev"